# proto-file: api/plan/v1/plan.proto
# proto-message: plan.v1.ProjectSettings
# Djinn's own settings: docs/team-settings.md. Your own file, in Djinn's data folder, wins setting by setting.

# Djinn integrates finished work by itself. npm ci makes a fresh worktree ready (ESLint, the protoc plugins); a conflict
# only in what go tool task gen makes is settled by making it again.
setup: "npm ci"
generated: "gen/**"
generate: "go tool task gen"

# The lint before each task's work is committed; the whole test suite, too long for each commit, before each push.
checks { name: "lint" command: "go tool task lint" when: CHECK_WHEN_COMMIT }
checks { name: "test" command: "go tool task test" when: CHECK_WHEN_PUSH }

# Once pushed, the window proposes to install the build and restart on it.
install: "go tool task install"
