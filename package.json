{
  "name": "djinn-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "A visual flight plan for agentic work",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "desktop": "node scripts/desktop.cjs",
    "start": "electron .",
    "build": "tsc -b && vite build",
    "test": "node --test --require ./tests/setup-language.cjs tests/*.test.cjs",
    "test:e2e": "playwright test",
    "package": "npm run build && electron-builder --dir",
    "package:local": "npm run build && node scripts/package-local.cjs",
    "verify:local-package": "node scripts/verify-local-package.cjs",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "app.djinn.desktop",
    "productName": "Djinn",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "locales/*.json",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Empowill/Djinn.git"
  }
}
